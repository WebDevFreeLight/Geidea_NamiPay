# Build output (leading **/ so it matches bin/obj folders in every project, not just the repo root)
**/[Bb]in/*
**/[Oo]bj/
*.pdb
*.exe
*.vshost.*

# The native mada payment DLLs (DllImport) live in Vendor/Geidea/ (CDLL, CDLL.Net40 and
# NewImplementations/Mada.Api link these same files, so they are the single source).
# *.dll is NOT ignored outside bin/, so Vendor/ and NamiPay/ DLLs stay tracked.

# Runtime logs / receipts (may contain transaction data)
ECRLOG_*.txt
reconrcpt.html

# Visual Studio
.vs/
*.user
*.suo
