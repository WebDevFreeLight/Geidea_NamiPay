<?xml version="1.0" encoding="utf-8"?>
<!--
  EN: Application configuration. At build time this file is copied next to the exe as CDLL.exe.config.
      Edit bin\Debug\CDLL.exe.config to change settings without recompiling.
  AR: ملف إعدادات التطبيق. عند البناء يُنسخ بجانب البرنامج باسم CDLL.exe.config.
      عدّل bin\Debug\CDLL.exe.config لتغيير الإعدادات بدون إعادة البناء.
-->
<configuration>
<startup>
	<!-- EN: Requires .NET Framework 4.8 (needed by the SQLite library).   AR: يتطلب ‎.NET Framework 4.8 (مطلوب لمكتبة SQLite). -->
	<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
</startup>
	<appSettings>
		<!--
		  EN: DEFAULT VALUES shown in Form1 when it opens. Every value can still be changed on the form,
		      and the "Save defaults" button writes the current form values into CDLL.exe.config.
		      Numbers use "." as decimal separator; the date is yyyy-MM-dd (Gregorian).
		  AR: القيم الافتراضية التي تظهر في Form1 عند فتحها. يمكن تغيير كل قيمة من النافذة،
		      وزر "حفظ الافتراضي" يكتب القيم الحالية في CDLL.exe.config.
		      الأرقام تستخدم "." كفاصل عشري، والتاريخ بصيغة yyyy-MM-dd (ميلادي).
		-->

		<!-- EN: COM port of the terminal (8 = COM8). Find it in Device Manager > Ports (COM & LPT).
		         The PAX A920Pro over USB shows two "USB Serial Device" ports (COM8, COM9); only COM8 answered Check status.
		     AR: منفذ COM للجهاز (8 = COM8). تجده في "إدارة الأجهزة" > المنافذ (COM و LPT).
		         جهاز PAX A920Pro عبر USB يظهر بمنفذين "USB Serial Device" (COM8 و COM9)، و COM8 فقط استجاب لفحص الحالة. -->
		<add key="PaymentMachinePort" value="8"/>
		<!-- EN: Serial settings: baud rate, parity (0 = none), data bits, stop bits (0 = one stop bit).
		     AR: إعدادات المنفذ التسلسلي: السرعة، التماثل (0 = بدون)، بتات البيانات، بتات التوقف (0 = بت واحد). -->
		<add key="BaudRate" value="38400"/>
		<add key="Parity" value="0"/>
		<add key="DataBits" value="8"/>
		<add key="StopBits" value="0"/>
		<!-- EN: Terminal network address for the TCP buttons.   AR: عنوان الجهاز على الشبكة لأزرار TCP. -->
		<add key="TerminalIp" value="192.168.116.166"/>
		<add key="TerminalTcpPort" value="6100"/>
		<!-- EN: Transaction values (amounts in SAR).   AR: قيم العملية (المبالغ بالريال). -->
		<add key="PurchaseAmount" value="00.01"/>
		<add key="RefundAmount" value="00.01"/>
		<add key="OriginalRrn" value="434615455456"/>
		<add key="OriginalDate" value="2024-12-11"/>
		<!--
		  EN: Which window opens at startup (read in Program.cs).
		      false = Form1, the real terminal through madaapi_v1_9.dll / madaapi_v1_8.dll (default, unchanged).
		      true  = SimulatorForm: same 12 buttons with fake results. No terminal or DLL needed, NO real payments.
		      Keep "false" on any machine that takes real payments.
		  AR: أي نافذة تُفتح عند التشغيل (تُقرأ في Program.cs).
		      false = Form1، الجهاز الفعلي عبر madaapi_v1_9.dll و madaapi_v1_8.dll (الافتراضي، بدون تغيير).
		      true  = SimulatorForm: نفس الأزرار الاثني عشر بنتائج وهمية. لا حاجة لجهاز ولا مكتبة، ولا عمليات دفع حقيقية.
		      اترك القيمة "false" على أي جهاز يستقبل مدفوعات حقيقية.
		-->
		<add key="UseSimulator" value="false"/>

		<!--
		  EN: Terminal used by Form1 (read in PaymentServices.FromConfig).
		      Real      = the madaapi DLLs and the real terminal.
		      Simulator = Form1 with the fake terminal (MadaApiSimulator): everything is still saved, NO real payments.
		      TerminalTimeoutSeconds = how long Form1 waits for a payment / refund / repeat / reconciliation before "Timeout" (10-600).
		      TerminalStatusTimeoutSeconds = the same for Check status / Terminal ID / Merchant info / Test connection (5-120).
		      Before every USB call the COM port is checked (exists, not in use) within 3 s, so a wrong port never hangs.
		  AR: الجهاز الذي تستخدمه Form1. Real = الجهاز الفعلي، Simulator = جهاز وهمي (يُحفظ كل شيء بدون مدفوعات حقيقية).
		      TerminalTimeoutSeconds = مدة انتظار العمليات المالية والتسوية قبل تسجيل "انتهاء المهلة".
		      TerminalStatusTimeoutSeconds = نفس الشيء لفحص الحالة ورقم الجهاز وبيانات التاجر واختبار الاتصال.
		      قبل كل استدعاء USB يُفحص منفذ COM (موجود وغير مستخدم) خلال 3 ثوانٍ، حتى لا يتوقف البرنامج بسبب منفذ خاطئ.
		-->
		<add key="TerminalMode" value="Real"/>
		<!--
		  EN: Payment company of the terminal when this PC has no Terminal mapping: Geidea (madaapi DLLs) or
		      NamiPay (SkyBand ECR.dll). The mapping screen sets it per PC and can Detect it.
		      NamiPay.CashRegisterNumber = 8-digit cash register registered on the NamiPay terminal (if the mapping has none).
		      NamiPay.TerminalPrinter     = true to print the receipt on the NamiPay terminal.
		  AR: شركة الجهاز عند عدم وجود ربط لهذا الحاسوب: Geidea أو NamiPay. شاشة الربط تحددها لكل حاسوب ويمكنها كشفها.
		      NamiPay.CashRegisterNumber = رقم الصندوق (8 أرقام)، و NamiPay.TerminalPrinter = طباعة الإيصال على الجهاز.
		-->
		<add key="TerminalProvider" value="Geidea"/>
		<add key="NamiPay.CashRegisterNumber" value=""/>
		<add key="NamiPay.TerminalPrinter" value="false"/>
		<add key="TerminalTimeoutSeconds" value="120"/>
		<add key="TerminalStatusTimeoutSeconds" value="20"/>

		<!--
		  EN: Where every transaction, error and terminal mapping is saved.
		      Storage.Provider    = Sqlite (local file, default) | SqlServer (connectionStrings "PaymentsSqlServer") | Json (files)
		      Storage.DataFolder  = SQLite file, JSON files, pending\ (records saved while the database was down) and logs\
		      Storage.SqliteFile  = SQLite file name inside Storage.DataFolder
		  AR: مكان حفظ كل عملية وخطأ وربط جهاز.
		      Storage.Provider = Sqlite (ملف محلي، الافتراضي) أو SqlServer أو Json.
		      Storage.DataFolder = مجلد ملف SQLite وملفات JSON ومجلد pending\ (السجلات المحفوظة أثناء تعطل القاعدة) و logs\.
		-->
		<add key="Storage.Provider" value="Sqlite"/>
		<add key="Storage.DataFolder" value="%ProgramData%\CDLL\Payments"/>
		<add key="Storage.SqliteFile" value="payments.db"/>

		<!--
		  EN: Host response codes that decide the outcome of a payment / refund when the DLL returns 0
		      (comma separated). Anything not listed and not empty = Declined.
		      The cancel and timeout codes are VENDOR-SPECIFIC: copy them from the mada ECR document.
		      DLL return code 8 = the terminal stopped the transaction (do not list it here). The call duration decides:
		      duration >= Outcome.CardTimeoutSeconds -> Timeout (no card in time), shorter -> Cancelled (cancel pressed).
		      The A920Pro waits 15 s for the card (return code 8 came after 15.5 s).
		  AR: رموز استجابة البنك التي تحدد نتيجة الدفع أو الاسترجاع عندما تُعيد المكتبة 0 (مفصولة بفواصل).
		      أي رمز غير مذكور وغير فارغ = مرفوض. رموز الإلغاء وانتهاء المهلة تختلف حسب المورّد، انسخها من وثيقة ECR.
		      رمز الإرجاع 8 = الجهاز أوقف العملية (لا تضفه هنا). المدة تحدد النتيجة:
		      المدة >= Outcome.CardTimeoutSeconds -> Timeout (لم تُقدَّم البطاقة)، وأقل -> Cancelled (ضُغط الإلغاء).
		      جهاز A920Pro ينتظر البطاقة 15 ثانية (وصل الرمز 8 بعد 15.5 ثانية).
		-->
		<add key="Outcome.ApprovedResponseCodes" value="000"/>
		<add key="Outcome.CancelledResponseCodes" value=""/>
		<add key="Outcome.TimeoutResponseCodes" value=""/>
		<add key="Outcome.CardTimeoutSeconds" value="15"/>

		<!--
		  EN: Who may open "Terminal mapping" (reassign a terminal to another PC): comma-separated Windows users
		      or groups, e.g. "HOSPITAL\BillingSupervisors". Empty = Windows administrators only (Run as administrator).
		  AR: من يحق له فتح "ربط الجهاز": مستخدمو أو مجموعات Windows مفصولة بفواصل. فارغ = مسؤولو Windows فقط.
		-->
		<add key="Mapping.AllowedUsersOrGroups" value=""/>
	</appSettings>

	<connectionStrings>
		<!--
		  EN: Used only when Storage.Provider = SqlServer. The database must exist; the tables are created on first use.
		      The value below is for LocalDB on this PC (LocalDB does not support Encrypt=True with this client).
		      SECURITY on the hospital server: Windows login + encrypted connection, e.g.
		        Data Source=DBSERVER;Initial Catalog=CDLL_Payments;Integrated Security=True;Encrypt=True
		      (the server needs a trusted certificate; do not add TrustServerCertificate=True in production).
		  AR: يُستخدم فقط عندما Storage.Provider = SqlServer. يجب أن تكون قاعدة البيانات موجودة، والجداول تُنشأ عند أول استخدام.
		      القيمة أدناه لـ LocalDB على هذا الحاسوب (LocalDB لا يدعم Encrypt=True مع هذا العميل).
		      الأمان على خادم المستشفى: تسجيل دخول Windows واتصال مشفّر (Encrypt=True) مع شهادة موثوقة.
		-->
		<add name="PaymentsSqlServer"
		     connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=CDLL_Payments;Integrated Security=True"
		     providerName="System.Data.SqlClient"/>
	</connectionStrings>
</configuration>
