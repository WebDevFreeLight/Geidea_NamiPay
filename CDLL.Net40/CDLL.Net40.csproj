    <!-- EN: What Microsoft.Bcl.Build's targets set (PackageReference does not import them): lets the
             System.Runtime / System.Threading.Tasks facades of Microsoft.Bcl satisfy Microsoft.Bcl.Async.
         AR: ما تضبطه أهداف Microsoft.Bcl.Build (لا يستوردها PackageReference) حتى تعمل Microsoft.Bcl.Async. -->
    <AutoUnifyAssemblyReferences>false</AutoUnifyAssemblyReferences>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
